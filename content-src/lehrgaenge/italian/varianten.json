  "ziel": [
   {
    "satz": "Im Evans-Gambit gibst du den b-Bauern her, damit der Läufer von Schwarz Zeit verliert und du mit c-Bauer und d-Bauer ein breites Zentrum baust. Wikipedia beschreibt das als Opfer für schnelle Entwicklung und Angriffschancen.",
    "status": "entwurf",
    "quelle": "https://en.wikipedia.org/wiki/Evans_Gambit"
   },
   {
    "satz": "Gegen Lc5 kommt d4 mit Tempo: Der Läufer muss wieder weichen, und mit der Rochade bietest du sogar den zweiten Bauern an. Wikipedia hält Lc5 für die schwächere Antwort, weil du mit dem d-Bauern Zeit gewinnst.",
    "status": "entwurf",
    "quelle": "https://en.wikipedia.org/wiki/Evans_Gambit"
   },
   {
    "satz": "Nimmt Schwarz auch den zweiten Bauern, folgt Lxf7+ Kxf7 Dd5+, und mit Dxc5+ gewinnst du den Läufer. Bei bester Verteidigung sieht die Engine dich klar besser (ab etwa +1,2); in der gezeigten Linie mit Ke8 Dh5+ g6 steigt es auf +3,6, weil Schwarz mit g6 ungenau spielt.",
    "status": "entwurf",
    "quelle": "Stockfish Tiefe 18 (aufgaben.json); Stockfish Tiefe 20 eigene Prüfung (nach 8…Kxf7 9.Dd5+: Kf8 −1,36, Ke8 −1,26, Linie mit g6 +3,6)"
   }
  ]
