  "ziel": [
   {
    "satz": "Beim Fried-Liver-Angriff gibst du einen Springer ab, um den schwarzen König in die Mitte zu zwingen: Nach Kxf7 und Df3+ steht er auf e6 und kann nicht mehr rochieren. Wikipedia nennt den Angriff stark, aber noch nicht als entscheidend bewiesen.",
    "status": "entwurf",
    "quelle": "https://en.wikipedia.org/wiki/Fried_Liver_Attack; https://en.wikibooks.org/wiki/Chess_Opening_Theory/1._e4/1...e5/2._Nf3/2...Nc6/3._Bc4/3...Nf6/4._Ng5/4...d5/5._exd5"
   },
   {
    "satz": "Schwarz antwortet mit Sb4 und c6 und stützt so den gefesselten Springer auf d5. Du rochierst und baust mit d4 die Mitte auf; die Engine sieht dich dabei nur leicht besser (+0,84).",
    "status": "entwurf",
    "quelle": "https://en.wikipedia.org/wiki/Fried_Liver_Attack; Stockfish Tiefe 18 (aufgaben.json)"
   },
   {
    "satz": "Das ist ein Angriff auf Risiko: Wikibooks bewertet die Stellung als unklar. Du spielst ihn auf Wirkung gegen Gegner, die ihn nicht kennen.",
    "status": "entwurf",
    "quelle": "https://en.wikibooks.org/wiki/Chess_Opening_Theory/1._e4/1...e5/2._Nf3/2...Nc6/3._Bc4/3...Nf6/4._Ng5/4...d5/5._exd5; docs/repertoire-v1.8.md (High Risk, High Reward)"
   }
