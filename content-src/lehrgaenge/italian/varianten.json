  "ziel": [
   {
    "satz": "Der Springertausch lässt Schwarz einen Bauern auf d4 vorgeschoben zurück. Du rochierst, entwickelst dich in Ruhe und holst ihn später mit dem c-Bauern ab; Wikipedia hält Sd4 gegen erfahrene Spieler für Zeitverschwendung.",
    "status": "entwurf",
    "quelle": "https://en.wikipedia.org/wiki/Italian_Game"
   },
   {
    "satz": "Zieht Schwarz danach Lc5, ist f7 wieder nur vom König gedeckt: Lxf7+ Kxf7 Dh5+ Ke7 Dxc5+ gewinnt den Läufer und danach den Bauern auf d4, also zwei Bauern. Die Engine sieht dich nach Lc5 klar besser (+3,67).",
    "status": "entwurf",
    "quelle": "https://en.wikibooks.org/wiki/Chess_Opening_Theory/1._e4/1...e5/2._Nf3/2...Nc6/3._Bc4/3...Nd4; Stockfish Tiefe 18 (aufgaben.json)"
   },
   {
    "satz": "Spielt Schwarz ruhiger, zum Beispiel Sf6, stehst du trotzdem gut: Nach der Rochade sieht die Engine dich klar besser (+1,20), und du drückst mit dem c-Bauern auf den vorgeschobenen Bauern auf d4.",
    "status": "entwurf",
    "quelle": "Stockfish Tiefe 18 (aufgaben.json); Sf6 Tiefe 20 eigene Prüfung (+1,29)"
   }
  ]
 },
