  "ziel": [
   {
    "satz": "Du entwickelst alle Figuren, ohne dir Bauernschwächen zu holen: Der Läufer geht über f5 nach g6, die Springer nach d7 und f6, und e6 stützt dein Zentrum. Am Ende hast du weder isolierte noch doppelte Bauern.",
    "status": "entwurf",
    "quelle": "https://en.wikipedia.org/wiki/Caro%E2%80%93Kann_Defence",
    "belege": [
     "struktur"
    ]
   },
   {
    "satz": "Durch den Tausch auf e4 ist die d-Linie für dich halboffen. Für später gilt: Mit dem c-Bauern kannst du vorrücken und Druck auf den Bauern d4 machen.",
    "status": "entwurf",
    "quelle": "https://de.wikipedia.org/wiki/Caro-Kann-Verteidigung ; https://en.wikipedia.org/wiki/Caro%E2%80%93Kann_Defence",
    "belege": [
     "struktur"
    ]
   },
   {
    "satz": "Rückt Weiß statt Sf3 mit dem h-Bauern vor, schiebst du deinen h-Bauern ein Feld: Dann hat der Läufer g6 das Feld h7 als Rückzug. Ein weit vorgerückter weißer h-Bauer kann im Endspiel zur Schwäche werden.",
    "status": "entwurf",
    "quelle": "https://de.wikipedia.org/wiki/Caro-Kann-Verteidigung",
    "belege": [
     "zugfolge"
    ]
   }
  ]
