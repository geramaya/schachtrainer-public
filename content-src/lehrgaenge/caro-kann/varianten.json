  "ziel": [
   {
    "satz": "Nach dem Tausch auf d5 steht jeder mit einem Zentrumsbauern auf d; keine Seite hat isolierte oder doppelte Bauern. Reihenfolge: erst Läufer und Springer entwickeln, dann den e-Bauern ziehen.",
    "status": "entwurf",
    "quelle": "eigene Beobachtung am Brett (Bauernstruktur nach der Linie, chess.js)",
    "belege": [
     "struktur"
    ]
   },
   {
    "satz": "Mit e6 sicherst du den Bauern d5; die Stellung gleicht dann der Abtauschvariante des Damengambits mit vertauschten Farben.",
    "status": "entwurf",
    "quelle": "https://de.wikipedia.org/wiki/Caro-Kann-Verteidigung",
    "belege": [
     "zugfolge"
    ]
   },
   {
    "satz": "Auf der c-Linie hast du keinen Bauern mehr, sie ist für dich halboffen. Achte später, nach 8. Se5, auf Weiß' Springer: Er greift den ungedeckten Läufer g4, den Springer c6 und den Bauern f7 an.",
    "status": "entwurf",
    "belege": [
     "struktur"
    ],
    "quelle": "eigene Beobachtung am Brett (Stellung nach 8. Se5, chess.js)"
   }
