    ]
   },
   {
    "satz": "Das übliche Muster der Vorstoßvariante: Der e-Bauer deckt den Bauern d5 und gibt dem Läufer f8 Raum. Danach greifst du mit dem c-Bauern den Bauern d4 an, das untere Ende der weißen Bauernkette.",
    "status": "entwurf",
    "quelle": "https://en.wikibooks.org/wiki/Chess_Opening_Theory/1._e4/1...c6/2._d4/2...d5/3._e5 ; https://de.wikipedia.org/wiki/Caro-Kann-Verteidigung",
    "belege": [
     "zugfolge"
    ]
   },
   {
    "satz": "Weiß versucht oft, den Läufer f5 mit einem Bauernvorstoß am Rand zu vertreiben, mit dem g- oder dem h-Bauern. Behalte die Randbauern im Blick.",
    "status": "entwurf",
    "quelle": "https://de.wikipedia.org/wiki/Caro-Kann-Verteidigung",
