{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Schachtrainer",
  "version": "0.1.0",
  "identifier": "local.schachtrainer.desktop",
  "build": {
    "beforeBuildCommand": "npm run engine && npm run maia && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Schachtrainer",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 760,
        "create": false
      }
    ],
    "security": {
      "capabilities": [],
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false
      },
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; connect-src 'self'; img-src 'self' data:; media-src 'self'; style-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
